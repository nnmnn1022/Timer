{
    "name": "ECTimer",
    "description": "업무 시간 관리를 위한 타이머",
    "version": "1.0",
    "manifest_version": 3,
    "permissions": [
      "tabs",
      "scripting",
      "activeTab",
      "storage"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ],
    "icons": {
      "16": "images/clock_16.png.png",
      "48": "images/clock_48.png.png"
    }
}